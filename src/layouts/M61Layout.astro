---
// Layout for the M61 landing pages (/landing, and the summit variant).
// Self-contained: does not pull in global.css or the agentic styles.
import "../styles/m61.css";

export interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  lang?: string;
  alternates?: { hreflang: string; href: string }[];
}
const { title, description, noindex = false, lang = "en", alternates = [] } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="icon" type="image/png" sizes="64x64" href="/images/favicon-64.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;600;800&display=swap" />
  </head>
  <body>
    <div class="wrap">
      <slot />
    </div>
  </body>
</html>
