---
// Three proof points under the hero. Pass a different list to override.
export interface Props {
  items?: { value: string; label: string }[];
}
const { items = [
  { value: "98–99%", label: "Accuracy in production, up from 70–80% at first build" },
  { value: "10+", label: "Agentic systems delivered and running live" },
  { value: "1000+", label: "Agents run from one place, with monitoring and audit built in" },
] } = Astro.props;
---

<div class="proof">
  {items.map((item) => (
    <div><b>{item.value}</b><span>{item.label}</span></div>
  ))}
</div>
